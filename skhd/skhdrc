
# --- Changing Focus ---
# change window focus within space
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - h : yabai -m window --focus west
alt - l : yabai -m window --focus east

# change focus to display left and right
alt - s: yabai -m display --focus west
alt - g: yabai -m display --focus east

ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - h : yabai -m window --warp west
ctrl + alt - l : yabai -m window --warp east

# move window to display left and right
ctrl + alt - s : yabai -m window --display west; yabai -m display --focus west;
ctrl + alt - g : yabai -m window --display east; yabai -m display --focus east;

# maximize a window
shift + alt - m : yabai -m window --toggle zoom-fullscreen

# toggle window float
shift + alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# snap floating window below sketchybar
ctrl + alt - r : yabai -m window --move abs:0:44

# move floating window with arrow keys
ctrl + alt - left  : yabai -m window --move rel:-20:0
ctrl + alt - right : yabai -m window --move rel:20:0
ctrl + alt - up    : yabai -m window --move rel:0:-20
ctrl + alt - down  : yabai -m window --move rel:0:20

# --- Window Snapping (Rectangle-style) ---

# Halves
shift + alt - left  : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 1:2:0:0:1:1
shift + alt - right : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 1:2:1:0:1:1
shift + alt - up    : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 2:1:0:0:1:1
shift + alt - down  : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 2:1:0:1:1:1

# Corners
ctrl + shift + alt - h : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 2:2:0:0:1:1
ctrl + shift + alt - l : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 2:2:1:0:1:1
ctrl + shift + alt - j : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 2:2:0:1:1:1
ctrl + shift + alt - k : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 2:2:1:1:1:1

# Thirds
shift + alt - 1 : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 1:3:0:0:1:1
shift + alt - 2 : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 1:3:1:0:1:1
shift + alt - 3 : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 1:3:2:0:1:1
shift + alt - 4 : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 1:3:0:0:2:1
shift + alt - 5 : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 1:3:1:0:2:1

# Center / sizing
shift + alt - c : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 4:4:1:1:2:2
shift + alt - a : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 6:6:1:1:4:4
shift + alt - z : yabai -m query --windows --window | grep -q '"is-floating":false' && yabai -m window --toggle float; sleep 0.05; yabai -m window --grid 1:4:1:0:2:1

# Resize larger/smaller
shift + alt - 0x18 : yabai -m window --resize rel:40:40
shift + alt - 0x1B : yabai -m window --resize rel:-40:-40